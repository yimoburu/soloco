+                "cwd": ".", "originator": "retention-test", "cli_version": "test",
+                "source": "cli", "model_provider": "test-provider"}
+        }).to_string();
+        let response = serde_json::json!({
+            "timestamp": "2025-01-03T12:00:00Z", "type": "response_item",
+            "payload": {"type": "message", "role": "assistant",
+                "content": [{"type": "output_text", "text": "retained original"}]}
+        });
+        let original_line = format!("  {response}  ");
+        let contents = format!("{metadata}\n\n{original_line}\n");
+        tokio::fs::write(&path, contents.as_bytes()).await?;
+        let expected_path = path.display().to_string();
+        let (items, loaded_thread_id, parse_errors) =
+            RolloutRecorder::load_rollout_items(path.as_path()).await?;
+        drop(path);
+        assert_eq!(loaded_thread_id, Some(thread_id));
+        assert_eq!(parse_errors, 0);
+        let envelope = items.iter().find_map(|item| match item {
+            RolloutItem::ResponseItem(envelope) => Some(envelope),
+            _ => None,
+        }).expect("original response item");
+        let receipt = envelope.metadata.as_ref()
+            .and_then(|metadata| metadata.original_item_receipt.as_ref());
+        if option_env!("SOLOCO_PROTECTED_HOST_BUILD") == Some("1") {
+            let receipt = receipt.expect("actual protected original reader receipt");
+            assert_eq!(receipt.original_read(),
+                Some((expected_path.as_str(), 3, original_line.as_bytes())));
+            assert_eq!(receipt.original_thread_metadata_bytes(), Some(metadata.as_bytes()));
+            assert_eq!(receipt.original_thread_id(), Some(thread_id.to_string().as_str()));
+        } else {
+            assert!(receipt.is_none(), "ordinary reads do not mint protected receipts");
+        }
+        // The retained bytes survive the caller path and later file replacement.
+        let path = home.path().join("original-rollout.jsonl");
+        tokio::fs::write(&path, b"replaced after original read\n").await?;
+        if let Some(receipt) = receipt {
+            assert_eq!(receipt.original_read(),
+                Some((expected_path.as_str(), 3, original_line.as_bytes())));
+        }
+        // A later incomplete original read must not reuse the earlier good receipt.
+        tokio::fs::write(&path, format!("{contents}not JSON\n")).await?;
+        let (partial, _, parse_errors) = RolloutRecorder::load_rollout_items(&path).await?;
+        assert_eq!(parse_errors, 1);
+        for item in partial {
+            if let RolloutItem::ResponseItem(envelope) = item {
+                assert!(envelope.metadata.as_ref()
+                    .and_then(|metadata| metadata.original_item_receipt.as_ref()).is_none());
+            }
+        }
+        Ok(())
+    }
+}
