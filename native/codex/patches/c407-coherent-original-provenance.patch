+/// Only actual ItemStarted passes the private scoped writer and original native
+/// oneshot here. Ordinary callers retain the existing decoder path below.
+pub(crate) async fn on_call_response_with_original(
+    call_id:String,receiver:oneshot::Receiver<ClientRequestResult>,conversation:Arc<CodexThread>,
+    decoder:Option<Arc<crate::protected_host::OriginalScopedDecoderRuntime>>,
+    exchange:Option<codex_protocol::dynamic_tools::original_exchange::OriginalDynamicExchange>,
+) {
+    let (Some(decoder),Some(exchange))=(decoder,exchange) else {
+        return on_call_response(call_id,receiver,conversation).await;
+    };
+    let input=match receiver.await {
+        Ok(Ok(value))=>codex_api::protected_peer::OriginalNativeClientReturn::Value(value),
+        Ok(Err(err)) if is_turn_transition_server_request_error(&err)=>{
+            exchange.observe_unresolved();return;
+        }
+        Ok(Err(err))=>{
+            error!("request failed with client error: {err:?}");
+            codex_api::protected_peer::OriginalNativeClientReturn::ClientError
+        }
+        Err(err)=>{
+            error!("request failed: {err:?}");
+            codex_api::protected_peer::OriginalNativeClientReturn::ChannelClosed
+        }
+    };
+    let Some(response)=decoder.decode(&exchange,input) else {exchange.observe_unresolved();return;};
+    if let Err(err)=conversation.submit(Op::DynamicToolResponse{id:call_id,response}).await {
+        exchange.observe_unresolved();
+        error!("failed to submit original DynamicToolResponse: {err}");
+    }
+}
