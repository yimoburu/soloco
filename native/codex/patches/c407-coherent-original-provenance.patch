+        assert_eq!(catalog_origin_hold(ModelOrigin::Provider, true, false), Some("provider_catalog_current_fetch_source_binding_not_retained"));
+        assert!(catalog_origin_hold(ModelOrigin::Provider, false, false).is_some());
