+        assert_eq!(catalog_origin_hold(ModelOrigin::Bundled, true, false), None);
+        assert_eq!(catalog_origin_hold(ModelOrigin::Provider, true, true), None);
+        assert!(catalog_origin_hold(ModelOrigin::Synthetic, true, true).is_some());
+    }
+}
