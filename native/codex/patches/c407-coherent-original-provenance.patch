+        text.replacen("\"source_cut_protocol\":null","\"source_cut_protocol\":\"peer-origin-maintenance-context-v1\"",1),
+        text.replacen("\"protocol\":\"soloco-peer-context-frame-v2\"","\"protocol\":\"soloco-peer-context-frame-v1\"",1),
