+fn generation(previous: &mut Option<String>, current: String, n: &mut u64) -> Result<(), TransportError> {
+    if previous.as_ref() != Some(&current) {
+        *n = n.checked_add(1).ok_or_else(|| hold("generation overflow"))?;
+        *previous = Some(current);
+    }
+    Ok(())
+}
