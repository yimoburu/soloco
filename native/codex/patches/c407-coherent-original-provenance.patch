+    /// An arbitrary owner on another runtime cannot match the actual step.
+    pub fn original_session_ingress_for_core(&self, owner: Arc<CoreOwner>) -> OriginalSessionIngress {
+        self.session_ingress(Some(Arc::downgrade(&owner)))
