+    /// Original direct instruction field selected by actual enabled layer order.
+    /// Profiles and any later unproved contributor remain unsupported, including
+    /// a supplied equal string: equal content does not establish its producer.
+    pub fn original_direct_instruction(&self, field: &'static str, actual: &str) -> Option<OriginalConfigInstruction> {
+        if !matches!(field, "base_instructions" | "developer_instructions") { return None; }
+        let mut selected = None;
+        for layer in self.layers_low_to_high() {
+            if layer.config.get("profiles").is_some() || layer.config.get("profile").is_some() { return None; }
+            let Some(value) = layer.config.get(field) else { continue; };
+            let text = value.as_str()?;
+            let read = layer.original_instruction_read.0.as_ref();
+            selected = read.filter(|read| read.name == layer.name && read.materialized == layer.config)
+                .and_then(|read| {
+                    let spans: DirectInstructionSpans = toml::from_str(&read.raw).ok()?;
+                    let token = match field { "base_instructions" => spans.base_instructions?,
+                        "developer_instructions" => spans.developer_instructions?, _ => return None };
+                    if token.get_ref() != text { return None; }
+                    Some(OriginalConfigInstruction { read: std::sync::Arc::clone(read), field,
+                        token: token.span(), text: text.to_owned() })
+                });
+        }
+        selected.filter(|source| source.materialized_text() == actual)
+    }
