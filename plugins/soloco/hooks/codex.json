{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "COMPANY_PLUGIN_DATA=\"${CODEX_HOME:-$HOME/.codex}/plugins/data/soloco\" /bin/sh \"${PLUGIN_ROOT}/scripts/run.sh\" hook codex",
            "timeout": 150
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "COMPANY_PLUGIN_DATA=\"${CODEX_HOME:-$HOME/.codex}/plugins/data/soloco\" /bin/sh \"${PLUGIN_ROOT}/scripts/run.sh\" hook codex",
            "timeout": 150
          }
        ]
      }
    ]
  }
}
